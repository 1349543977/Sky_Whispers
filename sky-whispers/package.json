{
  "name": "sky-whispers",
  "version": "1.0.0",
  "description": "Sky Whispers (云端气象局) - 天气驱动的放置治愈社交小游戏",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/admin"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=sky-whispers-admin",
    "build:all": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=backend",
    "build:admin": "npm run build --workspace=sky-whispers-admin",
    "test:all": "npm run test --workspaces",
    "test:backend": "npm run test --workspace=backend",
    "lint:all": "npm run lint --workspaces",
    "lint:backend": "npm run lint --workspace=backend",
    "lint:admin": "npm run lint --workspace=sky-whispers-admin",
    "db:create": "cd backend && npx sequelize-cli db:create",
    "db:migrate": "cd backend && npx sequelize-cli db:migrate",
    "db:seed": "cd backend && npx sequelize-cli db:seed:all"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/sky-whispers.git"
  },
  "license": "UNLICENSED"
}
