# Server
PORT=3000
NODE_ENV=development

# Database (开发模式使用 SQLite，无需 MySQL)
DB_DIALECT=sqlite
DB_STORAGE=./data/sky_whispers.db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sky_whispers
DB_USER=root
DB_PASSWORD=

# Redis (开发模式使用 MockRedis，无需 Redis 服务)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=sky_whispers_dev_jwt_secret_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# WeChat Mini Program (开发模式使用测试值)
WECHAT_APP_ID=wx_test_app_id
WECHAT_APP_SECRET=wx_test_app_secret

# Weather API
WEATHER_API_KEY=
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Alibaba Cloud OSS
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=sky-whispers-assets
OSS_REGION=oss-cn-hangzhou
